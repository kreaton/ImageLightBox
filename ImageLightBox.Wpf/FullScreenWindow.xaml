<Window x:Class="ImageLightBox.Wpf.FullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageLightBox"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Black" Foreground="White"
        Loaded="OnLoaded"
        SizeChanged="OnSizeChanged"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseDoubleClick="OnDoubleClick">
    <Grid>
        <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        <!-- For a file that isn't an image, or an image that can't be decoded. -->
        <StackPanel x:Name="IconPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="IconGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="120" Foreground="#B4B4C4" HorizontalAlignment="Center" />
            <TextBlock x:Name="IconLabel" FontSize="20" FontWeight="SemiBold" Foreground="#B4B4C4" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock x:Name="IconName" FontSize="20" Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock x:Name="IconHint" FontSize="14" Foreground="#8A8A9C" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
        <Border Background="#99000000" CornerRadius="4" Padding="10,4" Margin="16"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <TextBlock x:Name="CaptionText" Foreground="White" />
        </Border>
        <Border Background="#99000000" CornerRadius="4" Padding="10,4" Margin="16"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <TextBlock Foreground="White" Text="Esc close  ·  ← → previous, next  ·  Del delete  ·  M move  ·  C copy  ·  L map" />
        </Border>
    </Grid>
</Window>
