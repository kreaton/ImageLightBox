<Window x:Class="ImageLightBox.Wpf.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Map"
        Icon="app.ico"
        Width="760" Height="600" MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FF0D0D13"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="OnLoaded">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="MessageText" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" Foreground="#8A8A9C"
                       Text="Loading the map..." />
            <Button x:Name="BrowserButton" Content="Open in browser" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Visibility="Collapsed" Click="OnOpenInBrowser" />
        </StackPanel>
        <!-- Must start visible: created hidden, it can stay at zero size and never show the map. -->
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#0D0D13" />
    </Grid>
</Window>
